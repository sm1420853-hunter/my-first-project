/* =================================
   COMMUNITY FIRST CBO WEBSITE
   Main stylesheet
================================= */

:root {
  --green: #145b45;
  --green-dark: #0b3d30;
  --green-light: #e9f4ee;
  --gold: #e5b65b;
  --white: #ffffff;
  --text: #25342e;
  --muted: #66756e;
  --background: #f7f9f7;
  --border: #e0e8e2;
  --shadow: 0 12px 35px rgba(18, 66, 49, 0.09);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 85px;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  color: var(--text);
  background: var(--white);
  line-height: 1.7;
}

img {
  display: block;
  width: 100%;
  object-fit: cover;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea,
select {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

.container {
  width: min(1140px, 90%);
  margin-inline: auto;
}

.section {
  padding: 95px 0;
}

.section-muted {
  background: var(--background);
}

/* Header and navigation */

.header {
  position: sticky;
  top: 0;
  z-index: 1000;
  background: rgba(255, 255, 255, 0.98);
  border-bottom: 1px solid var(--border);
}

.navbar {
  min-height: 82px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 25px;
}

.logo {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: var(--green);
  font-size: 21px;
  font-weight: 800;
  line-height: 1.25;
  flex-shrink: 0;
}

.logo-icon {
  width: 43px;
  height: 43px;
  display: grid;
  place-items: center;
  background: var(--green);
  color: var(--gold);
  border-radius: 12px;
  font-size: 28px;
}

.logo-light {
  color: #9b7832;
}

.logo small {
  display: block;
  margin-top: 4px;
  font-size: 8px;
  letter-spacing: 1.2px;
  color: var(--muted);
}

.nav-links {
  list-style: none;
  display: flex;
  align-items: center;
  gap: 25px;
}

.nav-links > li > a:not(.btn) {
  font-size: 13px;
  font-weight: 700;
  transition: color 0.2s ease;
}

.nav-links > li > a:hover,
.nav-links > li > a:focus-visible {
  color: #a77a25;
}

.menu-toggle {
  display: none;
  border: 0;
  background: var(--green-light);
  color: var(--green);
  font-size: 25px;
  width: 45px;
  height: 45px;
  border-radius: 9px;
  cursor: pointer;
}

/* Buttons */

.btn {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  border: 2px solid var(--green);
  border-radius: 6px;
  background: var(--green);
  color: var(--white);
  padding: 13px 22px;
  font-weight: 700;
  font-size: 14px;
  cursor: pointer;
  transition: background 0.2s, transform 0.2s;
}

.btn:hover {
  background: var(--green-dark);
  border-color: var(--green-dark);
  transform: translateY(-2px);
}

.btn-small {
  padding: 9px 15px;
  font-size: 12px;
}

.btn-outline {
  color: var(--white);
  border-color: rgba(255, 255, 255, 0.8);
  background: transparent;
}

.btn-outline:hover {
  background: var(--white);
  color: var(--green);
}

.btn-white {
  background: var(--white);
  color: var(--green);
  border-color: var(--white);
}

.btn-white:hover {
  background: var(--green-light);
  border-color: var(--green-light);
  color: var(--green-dark);
}

/* Hero */

.hero {
  position: relative;
  min-height: 590px;
  display: flex;
  align-items: center;
  background: url("https://unsplash.com") center 45% / cover no-repeat;
  color: var(--white);
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    90deg,
    rgba(5, 36, 27, 0.91) 0%,
    rgba(9, 57, 42, 0.77) 52%,
    rgba(9, 57, 42, 0.25) 100%
  );
}

.hero-content {
  position: relative;
  z-index: 1;
  padding-block: 90px;
}

.eyebrow {
  display: inline-block;
  color: var(--green);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2px;
  margin-bottom: 15px;
}

.eyebrow.light {
  color: var(--gold);
}

.hero h1 {
  font-size: clamp(37px, 5vw, 65px);
  line-height: 1.12;
  max-width: 760px;
  letter-spacing: -1.7px;
  margin-bottom: 22px;
}

.hero h1 span,
.about-text h2 span,
.volunteer-grid h2 span {
  color: var(--gold);
}

.hero-content > p {
  max-width: 600px;
  color: rgba(255, 255, 255, 0.9);
  font-size: 17px;
  margin-bottom: 30px;
}

.hero-buttons {
  display: flex;
  gap: 13px;
  flex-wrap: wrap;
}

.hero-note {
  margin-top: 30px;
  font-size: 12px;
  color: rgba(255, 255, 255, 0.8);
}

/* Intro strip */

.intro-strip {
  background: var(--white);
  border-bottom: 1px solid var(--border);
}

.intro-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px;
  padding-block: 28px;
}

.intro-grid > div {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 13px;
}

.strip-icon {
  display: grid;
  place-items: center;
  flex-shrink: 0;
  width: 43px;
  height: 43px;
  border-radius: 50%;
  background: var(--green-light);
  color: var(--green);
  font-size: 20px;
}

.intro-grid strong,
.intro-grid small {
  display: block;
}

.intro-grid strong {
  font-size: 14px;
}

.intro-grid small {
  font-size: 12px;
  color: var(--muted);
}

/* About */

.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 75px;
  align-items: center;
}

.about-visual {
  position: relative;
  padding: 0 20px 20px 0;
}

.about-visual > img {
  height: 490px;
  border-radius: 12px;
}

.image-caption {
  position: absolute;
  bottom: 0;
  right: 0;
  width: min(260px, 85%);
  padding: 20px 23px;
  border-radius: 9px;
  background: var(--green);
  color: var(--white);
  box-shadow: var(--shadow);
}

.image-caption strong,
.image-caption span {
  display: block;
}

.image-caption span {
  font-size: 13px;
  color: #dbece3;
}

.about-text h2,
.volunteer-grid h2 {
  font-size: clamp(29px, 3vw, 40px);
  line-height: 1.2;
  letter-spacing: -0.7px;
  margin-bottom: 22px;
}

.about-text h2 span,
.volunteer-grid h2 span {
  color: var(--green);
}

.about-text > p,
.volunteer-grid > div > p {
  color: var(--muted);
  margin-bottom: 17px;
  font-size: 15px;
}

.mission-card {
  margin-top: 19px;
  padding: 16px 19px;
  background: var(--green-light);
  border-left: 4px solid var(--green);
  border-radius: 4px;
}

.mission-card strong {
  color: var(--green);
}

.mission-card p {
  font-size: 13px;
  color: var(--muted);
  margin-top: 4px;
}

.vision-card {
  background: #fff7e8;
  border-color: var(--gold);
}

.vision-card strong {
  color: #805e1e;
}

.text-link {
  display: inline-block;
  margin-top: 16px;
  color: var(--green);
  font-size: 13px;
  font-weight: 800;
}

.text-link:hover {
  text-decoration: underline;
}

/* Programs */

.section-heading {
  max-width: 680px;
  text-align: center;
  margin: 0 auto 45px;
}

.section-heading h2 {
  font-size: clamp(30px, 4vw, 42px);
  line-height: 1.2;
  margin-bottom: 14px;
}

.section-heading > p {
  color: var(--muted);
  font-size: 15px;
}

.program-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 25px;
}

.program-card {
  overflow: hidden;
  border: 1px solid var(--border);
  background: var(--white);
  border-radius: 10px;
  box-shadow: 0 5px 20px rgba(20, 70, 50, 0.04);
  transition: transform 0.25s, box-shadow 0.25s;
}

.program-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow);
}

.program-card > img {
  height: 220px;
  width: 100%;
}

.program-body {
  padding: 24px;
}

.program-number {
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.2px;
  color: #a27b32;
}

.program-body h3 {
  margin: 8px 0 12px;
  font-size: 21px;
  line-height: 1.3;
}

.program-body p {
  color: var(--muted);
  font-size: 14px;
}

/* Volunteer & New Sections Forms Engine Integration */
.donor-showcase-grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 60px;
  align-items: center;
}

.donor-pitch p {
  color: var(--muted);
  margin-bottom: 25px;
}

.donor-form-card {
  background: var(--white);
  padding: 35px;
  border-radius: 10px;
  border: 1px solid var(--border);
  box-shadow: var(--shadow);
}

.donor-form-card h3 {
  font-size: 19px;
  margin-bottom: 5px;
  color: var(--green-dark);
}

.volunteer-form .form-group, #directContactForm .form-group {
  margin-bottom: 18px;
}

.volunteer-form label, #directContactForm label {
  display: block;
  font-size: 13px;
  font-weight: 700;
  color: var(--green);
  margin-bottom: 6px;
}

.volunteer-form input, .volunteer-form select, #directContactForm input {
  width: 100%;
  padding: 11px;
  border: 1px solid var(--border);
  border-radius: 6px;
  background: var(--background);
  color: var(--text);
  outline: none;
  transition: border-color 0.2s ease;
}

.volunteer-form input:focus, .volunteer-form select:focus, #directContactForm input:focus {
  border-color: var(--green);
  background: var(--white);
}

/* Get Involved & Direct Links System */
.contact-max-wrapper {
  max-width: 800px;
  margin: 0 auto;
}

.highlight-link {
  color: var(--green);
  font-weight: bold;
  text-decoration: underline;
}

.highlight-link:hover {
  color: var(--gold);
}

/* Responsive Adaptive Viewports */
@media (max-width: 991px) {
  .section { padding: 65px 0; }
  .about-grid, .donor-showcase-grid { grid-template-columns: 1fr; gap: 45px; }
  .about-visual > img { height: 380px; }
}

@media (max-width: 768px) {
  .menu-toggle { display: block; }
  .nav-links { display: none; }
  .intro-grid { grid-template-columns: 1fr; gap: 15px; }
  .hero { min-height: 520px; }
}
